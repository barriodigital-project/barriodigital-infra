# Copy this file to the workspace root as .env and set private local values.
# DB_PASSWORD is the local MySQL root password; DB_APP_PASSWORD is for services.
DB_PASSWORD=change-me-root-local
DB_APP_PASSWORD=change-me-app-local

BFF_PORT=8080
EUREKA_PORT=8761
CORS_ALLOWED_ORIGINS=http://localhost:4200
HTTP_CONNECT_TIMEOUT=2s
HTTP_READ_TIMEOUT=5s

# Cognito JWT validation for BarrioDigital.
JWT_JWK_SET_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_3bmXjc6m9/.well-known/jwks.json
JWT_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_3bmXjc6m9
JWT_CLIENT_ID=nk9ndigbp21o7756jiqe5ofc9

# For AWS, copy this file to .env.aws on the Manager and replace the CORS
# example. The deploy script reads only the deployment keys below and
# derives ECR_REGISTRY from STS; it does not read database passwords from here.
AWS_REGION=us-east-1
ECR_REGISTRY=
BFF_IMAGE_TAG=latest
CATALOG_IMAGE_TAG=latest
REQUESTS_IMAGE_TAG=latest
CREWS_IMAGE_TAG=latest
REPORT_IMAGE_TAG=latest
EUREKA_IMAGE_TAG=latest
SQS_EVENTS_ENABLED=false
REQUEST_EVENTS_QUEUE_URL=
SQS_POLL_INTERVAL_MS=1000

# EP3 infrastructure reuses the running EC2 instances and their security group.
EP3_STACK_NAME=barriodigital-ep3
MANAGER_INSTANCE_ID=
WORKER_INSTANCE_ID=
MANAGER_PRIVATE_IP=172.31.44.218
WORKER_PRIVATE_IP=172.31.26.255
VPC_ID=
VPC_SUBNET_IDS=
SWARM_SECURITY_GROUP_ID=
LAMBDA_ROLE_NAME=LabRole
LAMBDA_IMAGE_TAG=latest
LAMBDA_IMAGE_URI=

# Replace the CORS origin with the production HTTPS frontend origin.
EUREKA_SERVER_URL=http://eureka:8761/eureka/
REQUESTS_SERVICE_URL=http://request-ms
CATALOG_SERVICE_URL=http://catalog-ms
CREWS_SERVICE_URL=http://crews-ms
REPORT_SERVICE_URL=http://report-ms
